# Used by Netlify and Cloudflare Pages (GitHub Pages ignores this file; it caches for ~10 min by itself).
# Rules are written so no URL matches two of them.

/index.html
  Cache-Control: no-cache

# hashed JS/CSS bundles (file name changes whenever the content changes) -> cache for a year
/bundle/*
  Cache-Control: public, max-age=31536000, immutable

# big game assets (models, textures, HDRI, decoders): cache a week, then revalidate
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
